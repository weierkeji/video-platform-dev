{
  "name": "frameforge-studio",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/package-notices.mjs",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:media": "tsx scripts/media-smoke.ts",
    "smoke:workflow": "tsx scripts/workflow-smoke.ts",
    "smoke:animation": "tsx scripts/animation-smoke.ts",
    "smoke:mesh": "tsx scripts/mesh-smoke.ts",
    "smoke:gltf": "tsx scripts/gltf-smoke.ts",
    "smoke:textures": "tsx scripts/texture-smoke.ts",
    "format": "prettier --write src server scripts tests index.html vite.config.ts tsconfig.json package.json .prettierrc.json"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.56.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
