{
  "name": "frameforge-studio",
  "version": "0.27.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && node scripts/package-notices.mjs",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:media": "tsx scripts/media-smoke.ts",
    "smoke:workflow": "tsx scripts/workflow-smoke.ts",
    "smoke:animation": "tsx scripts/animation-smoke.ts",
    "smoke:mesh": "tsx scripts/mesh-smoke.ts",
    "smoke:gltf": "tsx scripts/gltf-smoke.ts",
    "smoke:textures": "tsx scripts/texture-smoke.ts",
    "smoke:animation-exchange": "tsx scripts/animation-exchange-smoke.ts",
    "smoke:playback": "tsx scripts/playback-smoke.ts",
    "smoke:layers": "tsx scripts/layers-smoke.ts",
    "smoke:bake": "tsx scripts/bake-smoke.ts",
    "smoke:skin": "tsx scripts/skin-smoke.ts",
    "smoke:constraints": "tsx scripts/constraints-smoke.ts",
    "format": "prettier --write src server scripts tests index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "smoke:ik": "tsx scripts/ik-smoke.ts",
    "smoke:ik-limits": "tsx scripts/ik-limits-smoke.ts",
    "smoke:ik-animation": "tsx scripts/ik-animation-smoke.ts",
    "smoke:rest-pose": "tsx scripts/rest-pose-smoke.ts",
    "smoke:ik-match": "tsx scripts/ik-match-smoke.ts",
    "smoke:retarget": "tsx scripts/retarget-smoke.ts",
    "smoke:reduce": "tsx scripts/reduce-smoke.ts",
    "smoke:adaptive": "tsx scripts/adaptive-smoke.ts",
    "smoke:keys": "tsx scripts/key-editing-smoke.ts",
    "smoke:parenting": "tsx scripts/parenting-smoke.ts",
    "smoke:objects": "tsx scripts/object-group-smoke.ts",
    "smoke:hierarchy": "tsx scripts/hierarchy-copy-smoke.ts",
    "smoke:data-users": "tsx scripts/data-users-smoke.ts",
    "smoke:clips": "tsx scripts/clip-editing-smoke.ts"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.56.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
