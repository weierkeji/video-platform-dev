# Server reads environment variables; copy values into your shell/session.
PORT=4173
# Optional: storage directory. Default is .local/data inside this repository.
# STUDIO_DATA_DIR=
# Optional: Chrome/Edge executable for background rendering.
# STUDIO_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# Optional: FFmpeg executable. Default: ffmpeg from PATH.
# STUDIO_FFMPEG_PATH=ffmpeg
# Optional: ffprobe executable. Defaults to ffprobe alongside a configured FFmpeg,
# or ffprobe from PATH when STUDIO_FFMPEG_PATH is unset.
# STUDIO_FFPROBE_PATH=ffprobe

# Seedance official API. Set secrets only in the server process environment.
# ARK_API_KEY=
# Optional default model/endpoint ID copied from your provider console.
# STUDIO_SEEDANCE_MODEL=
# Explicitly enable paid generation only after setting your provider-side budget.
# This application does not estimate costs or enforce a monetary budget.
STUDIO_ENABLE_PAID_GENERATION=false
